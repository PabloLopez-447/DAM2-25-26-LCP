<jasperReport name="InformeGlobal" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c6f9db8c-6184-44fe-b386-98b94277d35e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="dni" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT 
    a.dni AS alumno_dni,
    a.nombre AS alumno_nombre,
    a.apellidos AS alumno_apellidos,
    c.id AS curso_id,
    c.nombre AS curso_nombre,
    c.num_total_sesiones AS curso_num_total_sesiones,
    ca.nota_ev1 AS nota_ev1,
    ca.nota_ev2 AS nota_ev2,
    ca.nota_ev3 AS nota_ev3,
    ca.faltas AS faltas
 
FROM alumnos a
JOIN curso_alumno ca ON a.dni = ca.dni_alumno
JOIN cursos c ON ca.id_curso = c.id
WHERE a.dni =  $P{dni} 
ORDER BY c.nombre, a.apellidos, a.nombre
]]></query>
