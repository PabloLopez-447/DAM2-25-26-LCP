	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Gimnasio\DataAdapterGimnasio.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<query language="sql"><![CDATA[SELECT 
    u.nombre,
    u.apellidos,
    m.tipo_movimiento,
    m.fecha_hora
FROM movimientos m
JOIN usuarios u ON m.dni_usuario = u.dni
ORDER BY m.fecha_hora DESC]]></query>
