	<query language="sql"><![CDATA[SELECT gym.usuarios.nombre,
	gym.usuarios.apellidos,
	gym.movimientos.tipo,
	gym.movimientos.fecha
FROM gym.movimientos
	INNER JOIN gym.usuarios ON 
	 gym.movimientos.dni = gym.usuarios.dni]]></query>
