<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="POJOS.Proxecto" table="PROXECTO" schema="dbo" catalog="EMPRESAHB26">
        <id name="numProxecto" type="int">
            <column name="NumProxecto"/>
            <generator class="increment"/>
        </id>
        <property name="nomeProxecto" type="string">
            <column name="NomeProxecto" length="25" not-null="true" unique="true"/>
        </property>
        <property name="lugar" type="string">
            <column name="Lugar" length="25" not-null="true"/>
        </property>
        <!-- mapear las fase de proyecto como componente         -->
        <set name="fases" table="FASEPROXECTO">
            <key column="NumProxecto"/>
            <composite-element class="POJOS.ProxectoFase">
                <property name="nomeFase" column="NomeFase"/>
                <property name="estado" column="Estado"/>
            </composite-element>
        </set>

        <!--
Mapeo das participacións dun empregado/proxecto.
inverse="true":
   - Indica que este SET NON é o lado propietario da relación.
   - A FK real está na entidade intermedia EMPREGADO_PROXECTO.
   - Polo tanto, Hibernate NON debe facer INSERT/UPDATE da FK desde aquí.
cascade="all-delete-orphan":
   - cascade="all": Todas las operaciones de persistencia realizadas sobre la Empregado
    se propagan automáticamente a las entidades asociadas EMPREGADOPROXECTO.
   - delete-orphan: se se elimina unha participación deste SET,
     Hibernate elimina a fila correspondente da táboa EMPREGADO_PROXECTO
     porque queda “orfá” (sen entidade pai).
-->

        <set name="empregados" inverse="true" cascade="all-delete-orphan">
            <key column="NumProxecto"/>
            <one-to-many class="POJOS.EmpregadoProxecto"/>
        </set>


    </class>
</hibernate-mapping>
