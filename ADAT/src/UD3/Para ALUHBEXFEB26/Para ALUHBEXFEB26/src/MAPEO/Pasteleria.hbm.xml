<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<!--Pablo López Couso DNI:77550221V-->
<hibernate-mapping>
    <class name="POJOS.Pasteleria" table="PASTELERIA" schema="dbo" catalog="HBPASTELERIA26" >
       <id name="codigo" type="int">
            <column name="codigo" />
            <generator class="increment" /> <!-- clave incrementada por el servidor -->
      </id>       
        <property name="nome" type="string">
            <column name="Nome" length="30" not-null="true"  />
        </property>
        <property name="categoria" type="string">
            <column name="Categoria" length="40" />
        </property>
        <property name="localidade" type="string" unique="true"> <!-- nombre unico -->
            <column name="Localidade" length="40" not-null="true" />
        </property>

        <!-- mapeo pastelero -->
        <many-to-one class="POJOS.Pastelero" name="pastelero" fetch="select">
            <column name="Codpastelero"/>
        </many-to-one>

        <!-- mapeo productos -->
        <set name="productos" table="PASTELERIAPRODUCTO">
            <key column="Codpasteleria"/>
            <many-to-many class="POJOS.Producto" column="Codproducto"/>
        </set>
    </class>
</hibernate-mapping>
